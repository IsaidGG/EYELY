<div class="info-card">
    <h2 class="config-titulo">TÉRMINOS Y AYUDA</h2>

    <div class="info-layout">
         <img src="imagenes/robot/informacion/informacion.gif" class="robot-info-image" alt="Oftalmo-Bot Presentando">

        <div class="speech-bubble">
            <div id="texto-maquina-terminos" class="speech-text"></div>
        </div>
    </div>

    <div class="config-footer">
        [[VOLVER AL MENÚ->INICIO]]
    </div>
</div>

<script>
// Motor de máquina de escribir (Versión Multimensaje)
setTimeout(function() {
    // Aquí definimos los dos mensajes en orden
    const mensajes = [
        "Es importante comunicar que el sistema no sustituye un diagnóstico médico profesional, sino que funciona como una herramienta de orientación inicial.",
        "Se recomienda al usuario que ajuste su brillo en 'Configuración' para un mejor diagnóstico."
    ];
    
    const contenedorTexto = document.getElementById('texto-maquina-terminos');
    const sonidoBlip = document.getElementById('sonidoBlipTerminos');
    
    // Volumen suave para el 8-bits
    if(sonidoBlip) sonidoBlip.volume = 0.3; 

    let indiceMensaje = 0; // Controla qué mensaje estamos leyendo (0 o 1)
    let indiceLetra = 0;   // Controla qué letra estamos imprimiendo

    function escribirLetra() {
        let textoActual = mensajes[indiceMensaje];
        
        if (indiceLetra < textoActual.length) {
            // Escribimos la letra
            contenedorTexto.innerHTML += textoActual.charAt(indiceLetra);
            
            // Sonido (si no es un espacio)
            if (textoActual.charAt(indiceLetra) !== ' ' && sonidoBlip) {
                sonidoBlip.currentTime = 0; 
                sonidoBlip.play().catch(function(e){}); 
            }
            
            indiceLetra++;
            setTimeout(escribirLetra, 40); // Velocidad: 40ms por letra
            
        } else {
            // Cuando termina de escribir un mensaje entero...
            if (indiceMensaje === 0) {
                // Si era el PRIMER mensaje, iniciamos el temporizador de 5 segundos (5000 ms)
                setTimeout(function() {
                    contenedorTexto.innerHTML = ""; // Borramos el texto de golpe
                    indiceMensaje++; // Pasamos al segundo mensaje
                    indiceLetra = 0; // Reiniciamos el contador de letras
                    
                    // Esperamos medio segundo antes de empezar a escribir el nuevo mensaje
                    setTimeout(escribirLetra, 500); 
                }, 5000);
            }
            // Si es el segundo mensaje, ya no hace nada, se queda ahí fijo.
        }
    }

    // Arrancamos el motor
    escribirLetra();
}, 100);
</script>




