:: JuegoMain {"position":"300,500","size":"100,100"}
{
(set: $laminas to (a:
    (dm: "id", 1, "url", "imagenes/ishihara/lamina_1.png", "respuesta", "12"),
    (dm: "id", 2, "url", "imagenes/ishihara/lamina_2.png", "respuesta", "74"),
    (dm: "id", 3, "url", "imagenes/ishihara/lamina_3.png", "respuesta", "6"),
    (dm: "id", 4, "url", "imagenes/ishihara/lamina_4.png", "respuesta", "16"),
    (dm: "id", 5, "url", "imagenes/ishihara/lamina_5.png", "respuesta", "2"),
    (dm: "id", 6, "url", "imagenes/ishihara/lamina_6.png", "respuesta", "29"),
    (dm: "id", 7, "url", "imagenes/ishihara/lamina_7.png", "respuesta", "7"),
    (dm: "id", 8, "url", "imagenes/ishihara/lamina_8.png", "respuesta", "45"),
    (dm: "id", 9, "url", "imagenes/ishihara/lamina_9.png", "respuesta", "5"),
    (dm: "id", 10, "url", "imagenes/ishihara/lamina_10.png", "respuesta", "97"),
    (dm: "id", 11, "url", "imagenes/ishihara/lamina_11.png", "respuesta", "8"),
    (dm: "id", 12, "url", "imagenes/ishihara/lamina_12.png", "respuesta", "42"),
    (dm: "id", 13, "url", "imagenes/ishihara/lamina_13.png", "respuesta", "3"),
    (dm: "id", 14, "url", "imagenes/ishihara/lamina_14.png", "respuesta", "57")
))
(set: $laminas_totales to 14)

(if: $juego_iniciado is not true)[
    (set: $lamina_actual to 1)
    (set: $aciertos_ishihara to 0)
    (set: $errores_ishihara to 0)
    (set: $respuesta_usuario to "")
    
    (set: $robot_estado to "normal")
    (set: $dialogo_completo to false)
    (set: $juego_iniciado to true)
]

(set: $robot_image_url to "imagenes/robot/lvl1/robot_" + $robot_estado + ".png")
(set: $imagen_url to $laminas's ($lamina_actual)'s url)
(if: $lamina_actual is 1)[
  <div class="fade-in-overlay"></div>
]
}

<script>
    // 1. Apagamos la música del menú (si es que existe y está sonando)
    if (window.musicaMenu) {
        window.musicaMenu.pause();
    }
</script>

<audio id="musicaNivel1" src="sonido/lvl1.wav" autoplay loop></audio>

<script>
    // Guardamos esta nueva música en la memoria global
    window.musicaNivel1 = document.getElementById('musicaNivel1');
    
    // HCI Tip: Volumen bajo (0.5) para que el "Blip" del robot y los efectos se escuchen claro
    if(window.musicaNivel1) window.musicaNivel1.volume = 0.3;
</script>



<div class="game-layout-wrapper">
  
  <div class="game-control-panel">
    
    <div class="panel-header">
        <h2 class="panel-title">ISHIHARA COLOR VISION TEST (Level 1)</h2>
        <div class="panel-counters">
            <span class="counter-text">Numero: $lamina_actual of $laminas_totales</span>
            <span class="counter-text">| ACIERTOS: $aciertos_ishihara / ERRORES: $errores_ishihara</span>
        </div>
    </div>

    <div class="panel-screen">
      (print: '<img src="' + $imagen_url + '" class="ishihara-plate" alt="Lámina de Ishihara">')
    </div>

    <div class="panel-console">
        <div class="console-item">
            (input: bind $respuesta_usuario)
        </div>
        <div class="console-item">
            <div class="submit-button-section">
                [[Verificar->VerificarRespuesta]]
            </div>
        </div>
        <div class="console-item">
            <div class="exit-button-section">
                [[Salir->INICIO]]
            </div>
        </div>
    </div>

  </div> 
  
  <div class="robot-companion-section">
      
      (if: $lamina_actual is 1)[
        <div id="robot-bubble" class="robot-speech-bubble">
            <div id="robot-text" class="robot-speech-text"></div>
        </div>
      ]

      (print: '<img src="' + $robot_image_url + '" class="robot-state-image" alt="Oftalmo-Bot">')
  </div>

</div>

<audio id="sonidoBlipRobot" src="sonido/1bit.mp3"></audio>

<script>
setTimeout(function() {
    const contenedorTexto = document.getElementById('robot-text');
    if (!contenedorTexto) return;

    const mensajes = [
        "El sistema se ha cifrado con una especie de protección contra robots, yo no podré resolver el código de desbloqueo.",
        "¿Podrías ayudarme a desbloquearlo descifrando los números escondidos en las figuras?"
    ];
    
    const globo = document.getElementById('robot-bubble');
    const sonidoBlip = document.getElementById('sonidoBlipRobot');
    
    if(sonidoBlip) sonidoBlip.volume = 0.9; 
    
    let indiceMensaje = 0;
    let indiceLetra = 0;

    function escribirLetra() {
        if(!document.getElementById('robot-text')) return; 

        let textoActual = mensajes[indiceMensaje];
        
        if (indiceLetra < textoActual.length) {
            contenedorTexto.innerHTML += textoActual.charAt(indiceLetra);
            
            if (textoActual.charAt(indiceLetra) !== ' ' && sonidoBlip) {
                sonidoBlip.currentTime = 0; 
                sonidoBlip.play().catch(function(e){}); 
            }
            indiceLetra++;
            setTimeout(escribirLetra, 40); 
            
        } else {
            if (indiceMensaje === 0) {
                setTimeout(function() {
                    if(document.getElementById('robot-text')) {
                        contenedorTexto.innerHTML = ""; 
                        indiceMensaje++;
                        indiceLetra = 0;
                        setTimeout(escribirLetra, 200); 
                    }
                }, 7000); 
            } else {
                setTimeout(function() {
                    if(globo) globo.classList.add('hidden'); 
                }, 2000);
            }
        }
    }
    escribirLetra();
}, 200);
</script>






:: VerificarRespuesta
{
(set: $respuesta_limpia to (trimmed: $respuesta_usuario))
(set: $respuesta_correcta to $laminas's ($lamina_actual)'s respuesta)

(if: $respuesta_limpia is $respuesta_correcta)[
    (set: $aciertos_ishihara to it + 1)
    (set: $robot_estado to "feliz")
](else:)[
    (set: $errores_ishihara to it + 1)
    (set: $robot_estado to "triste")
]

(set: $respuesta_usuario to "")
(set: $lamina_actual to it + 1)

(if: $lamina_actual > $laminas_totales)[
    (go-to: "ResultadosFinales")
](else:)[
    (go-to: "JuegoMain")
]
}


:: JuegoMain_UpdateDialogState
(set: $dialogo_completo to true)
(go-to: "JuegoMain")




:: ResultadosFinales
{
(set: _mensaje_diagnostico to "")
(set: _color_diag to "#000")

(if: $aciertos_ishihara >= 12)[
    (set: _mensaje_diagnostico to "DIAGNÓSTICO PRELIMINAR: Visión de color normal. No se detectan anomalías en la percepción cromática. ¡Excelente trabajo!")
    (set: _color_diag to "#004085")
](elseif: $aciertos_ishihara >= 8)[
    (set: _mensaje_diagnostico to "DIAGNÓSTICO PRELIMINAR: Se detectaron confusiones cromáticas leves. Sugiero ajustar el brillo de la pantalla o realizar una segunda prueba en un entorno bien iluminado.")
    (set: _color_diag to "#e65100")
](else:)[
    (set: _mensaje_diagnostico to "DIAGNÓSTICO PRELIMINAR: Alta tasa de error en patrones cromáticos. Se sugiere la evaluación de un profesional de la salud visual para descartar discromatopsia (daltonismo).")
    (set: _color_diag to "#b71c1c")
]
}

<div class="info-card" style="max-height: 90vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h2 class="config-titulo" style="font-size: 3vh; margin-bottom: 2vh;">REPORTE DE DIAGNÓSTICO VISUAL</h2>

    <div class="info-layout" style="display: flex; align-items: center; justify-content: center; gap: 3vw; width: 100%;">
        
        <div style="flex: 0 0 25%; text-align: center;">
            <img src="imagenes/robot/lvl1/robot_normal.png" class="robot-info-image" alt="Oftalmo-Bot Reporte" style="max-height: 40vh; max-width: 100%;">
        </div>

        <div class="speech-bubble" style="flex: 0 0 65%; padding: 2.5vh; box-sizing: border-box;">
            
            <div class="speech-text" style="font-size: 2vh; line-height: 1.3;">
                <p style="margin: 0 0 1vh 0;"><strong>Módulo 1 Completado:</strong> Visión Cromática (Test de Ishihara).</p>
                <p style="margin: 0 0 0.5vh 0;">🔹 Aciertos: $aciertos_ishihara de 14</p>
                <p style="margin: 0 0 1vh 0;">🔸 Errores: $errores_ishihara</p>
                <hr style="border-color: #00bcd4; margin: 1vh 0;">
                
                <p id="texto-diagnostico" style="margin: 0; font-weight: bold; color: (print: _color_diag); min-height: 6vh;"></p>
                
                <div id="hidden-diag" style="display: none;">(print: _mensaje_diagnostico)</div>
            </div>
        </div>
    </div>

    <div class="config-footer" style="margin-top: 3vh; display: flex; gap: 20px; justify-content: center;">
        [[INICIAR NIVEL 2->IntroNivelDos]] 
        [[VOLVER AL MENÚ PRINCIPAL->INICIO]]
    </div>
</div>

<audio id="sonidoBlipResultados" src="sonido/1bit.mp3"></audio>

<script>
    // Cambio de música
    if (window.musicaNivel1) {
        window.musicaNivel1.pause();
        window.musicaNivel1.currentTime = 0; 
    }
    if (window.musicaMenu) {
        window.musicaMenu.play().catch(function(e){});
    }

    // --- MOTOR DE TEXTO TIPO MÁQUINA DE ESCRIBIR ---
    setTimeout(function() {
        const contenedorVisible = document.getElementById('texto-diagnostico');
        const contenedorOculto = document.getElementById('hidden-diag');
        const sonidoBlip = document.getElementById('sonidoBlipResultados');
        
        if (!contenedorVisible || !contenedorOculto) return;
        if(sonidoBlip) sonidoBlip.volume = 0.9;

        // Leemos el texto que Twine escondió
        const mensaje = contenedorOculto.innerText.trim();
        let indiceLetra = 0;

        function escribirLetra() {
            // Detenemos el script si el usuario cambia de pasaje rápido
            if(!document.getElementById('texto-diagnostico')) return; 

            if (indiceLetra < mensaje.length) {
                contenedorVisible.innerHTML += mensaje.charAt(indiceLetra);
                
                if (mensaje.charAt(indiceLetra) !== ' ' && sonidoBlip) {
                    sonidoBlip.currentTime = 0; 
                    sonidoBlip.play().catch(function(e){}); 
                }
                
                indiceLetra++;
                setTimeout(escribirLetra, 40); // Velocidad, ajústala si la quieres más rápida
            }
        }
        
        escribirLetra();
    }, 200);
</script>









:: IntroNivelDos
{
(set: _texto_instrucciones to "<strong>Test de la 'E' Direccional (Cartilla de Snellen)</strong><br><br>Para que esta prueba tenga validez, por favor sigue estas instrucciones al pie de la letra:<br><br><span style='color: #004085;'>• Siéntate a exactamente <strong>1 metro</strong> de distancia de la pantalla.<br>• No hagas zoom en tu navegador.<br>• Indica hacia qué dirección apuntan las 'patas' de la letra E.</span><br><br><span style='color: #b71c1c; font-weight: bold;'>Atención: La letra se hará más pequeña en cada ronda. Solo tienes un intento por tamaño.</span>")
}

<div class="info-card" style="max-height: 90vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 2vh;">
    <h2 class="config-titulo" style="font-size: 3vh; margin-bottom: 2vh; margin-top: 0;">MÓDULO 2: AGUDEZA VISUAL</h2>

    <div class="info-layout" style="display: flex; align-items: center; justify-content: center; gap: 2vw; width: 100%; max-height: 60vh;">
        
        <div style="flex: 0 0 25%; text-align: center;">
            <img src="imagenes/robot/lvl1/robot_normal.png" class="robot-info-image" alt="Oftalmo-Bot" style="max-height: 35vh; max-width: 100%;">
        </div>

        <div class="speech-bubble" style="flex: 0 0 65%; padding: 2vh 3vh; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center;">
            
            <div class="speech-text" style="font-size: 1.9vh; line-height: 1.3; text-align: left;">
                
                <div id="texto-intro" style="min-height: 25vh;"></div>
                
                <div id="hidden-intro" style="display: none;">(print: _texto_instrucciones)</div>

            </div>
        </div>
    </div>

    <div class="config-footer" style="margin-top: 3vh; display: flex; justify-content: center;">
        <div class="boton-arcade">
        [[COMENZAR PRUEBA->JuegoNivelDos]]
    </div>
</div>

<audio id="sonidoBlipIntro" src="sonido/1bit.mp3"></audio>

<script>
setTimeout(function() {
    const contenedorVisible = document.getElementById('texto-intro');
    const contenedorOculto = document.getElementById('hidden-intro');
    const sonidoBlip = document.getElementById('sonidoBlipIntro');
    
    if (!contenedorVisible || !contenedorOculto) return;
    if(sonidoBlip) sonidoBlip.volume = 0.90;

    let htmlContent = contenedorOculto.innerHTML.trim();
    let index = 0;
    let isHTML = false;

    function escribirLetra() {
        if(!document.getElementById('texto-intro')) return;
        
        if (index < htmlContent.length) {
            let char = htmlContent.charAt(index);
            
            if (char === '<') isHTML = true;
            
            contenedorVisible.innerHTML = htmlContent.substring(0, index + 1);
            
            if (!isHTML && char !== ' ' && char !== '\n' && sonidoBlip) {
                sonidoBlip.currentTime = 0;
                sonidoBlip.play().catch(function(e){});
            }
            
            if (char === '>') isHTML = false;
            
            index++;
            setTimeout(escribirLetra, isHTML ? 0 : 20); 
        }
    }
    
    escribirLetra();
}, 200);
</script>



:: JuegoNivelDos
{
(if: $juego_e_iniciado is not true)[
    (set: $ronda_e to 1)
    (set: $aciertos_snellen to 0)
    (set: $errores_snellen to 0)
    (set: $tamano_actual to 30) 
    (set: $rotacion_actual to 0) 
    (set: $robot_estado to "normal")
    (set: $juego_e_iniciado to true)
]
(set: $robot_image_url to "imagenes/robot/lvl1/robot_" + $robot_estado + ".png")
}

(if: $ronda_e is 1)[
  <div class="fade-in-overlay"></div>
]

<div class="game-layout-wrapper">
  
  <div class="game-control-panel" style="margin-top: -10vh;">
    
    <div class="panel-header">
        <h2 class="panel-title">SNELLEN ACUITY TEST (Level 2)</h2>
        <div class="panel-counters">
            <span class="counter-text">ROUND: $ronda_e of 10</span>
            <span class="counter-text">| SUCCESSES: $aciertos_snellen / ERRORS: $errores_snellen</span>
        </div>
    </div>

    <div class="panel-screen" style="display: flex; justify-content: center; align-items: center; overflow: hidden; height: 35vh; margin-bottom: 2vh;">
        (print: '<img src="imagenes/lvl2/E.png" class="letra-snellen" style="height: ' + (text: $tamano_actual) + 'vh; transform: rotate(' + (text: $rotacion_actual) + 'deg);" alt="Letra E">')
    </div>

    <div class="panel-console">
        <div class="dpad-container">
            <div style="grid-column: 2; grid-row: 1;">(link: '<img src="imagenes/lvl2/arriba.png" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0px 5px 5px rgba(0,0,0,0.5));">')[(set: $eleccion_usuario to "arriba")(go-to: "EvaluarE")]</div>
            
            <div style="grid-column: 1; grid-row: 2;">(link: '<img src="imagenes/lvl2/izquierda.png" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0px 5px 5px rgba(0,0,0,0.5));">')[(set: $eleccion_usuario to "izquierda")(go-to: "EvaluarE")]</div>
            
            <div style="grid-column: 3; grid-row: 2;">(link: '<img src="imagenes/lvl2/derecha.png" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0px 5px 5px rgba(0,0,0,0.5));">')[(set: $eleccion_usuario to "derecha")(go-to: "EvaluarE")]</div>
            
            <div style="grid-column: 2; grid-row: 3;">(link: '<img src="imagenes/lvl2/abajo.png" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0px 5px 5px rgba(0,0,0,0.5));">')[(set: $eleccion_usuario to "abajo")(go-to: "EvaluarE")]</div>
        </div>
        
        <div class="console-item" style="margin-top: 2vh;">
            <div class="exit-button-section">
                [[EXIT->INICIO]]
            </div>
        </div>
    </div>

  </div> 
  
  <div class="robot-companion-section">
      (if: $ronda_e is 1)[
        <div id="robot-bubble" class="robot-speech-bubble">
            <div id="robot-text-n2" class="robot-speech-text" style="min-height: 8vh;"></div>
            <div id="hidden-n2-text" style="display: none;">Indica hacia dónde apuntan las líneas de la figura usando las flechas direccionales.</div>
        </div>
        
        <audio id="sonidoBlipN2" src="sonido/1bit.mp3"></audio>

        <script>
setTimeout(function() {
    const contenedorVisible = document.getElementById('robot-text-n2');
    const contenedorOculto = document.getElementById('hidden-n2-text');
    const sonidoBlip = document.getElementById('sonidoBlipN2');
    const globoEntero = document.getElementById('robot-bubble'); // Referencia al globo completo

    if (!contenedorVisible || !contenedorOculto) return;
    if(sonidoBlip) sonidoBlip.volume = 0.3;

    let htmlContent = contenedorOculto.innerHTML.trim();
    let index = 0;

    function escribirLetra() {
        if(!document.getElementById('robot-text-n2')) return;

        if (index < htmlContent.length) {
            let char = htmlContent.charAt(index);
            contenedorVisible.innerHTML += char;

            if (char !== ' ' && sonidoBlip) {
                sonidoBlip.currentTime = 0;
                sonidoBlip.play().catch(function(e){});
            }

            index++;
            setTimeout(escribirLetra, 40);
        } else {
            // ¡TERMINÓ DE ESCRIBIR! 
            // Iniciamos la cuenta regresiva de 5 segundos (5000 milisegundos)
            setTimeout(function() {
                if(globoEntero) {
                    // Le agregamos una transición suave por CSS o lo ocultamos directo
                    globoEntero.style.transition = "opacity 0.5s ease";
                    globoEntero.style.opacity = "0";
                    setTimeout(() => globoEntero.style.display = "none", 500); // Lo quitamos del flujo
                }
            }, 5000);
        }
    }
    escribirLetra();
}, 300);
</script>
      ]
      (print: '<img src="' + $robot_image_url + '" class="robot-state-image" alt="Oftalmo-Bot">')
  </div>

</div>


:: EvaluarE
{
(set: _respuesta_correcta to "")
(if: $rotacion_actual is 0)[
    (set: _respuesta_correcta to "derecha")
](elseif: $rotacion_actual is 90)[
    (set: _respuesta_correcta to "abajo")
](elseif: $rotacion_actual is 180)[
    (set: _respuesta_correcta to "izquierda")
](elseif: $rotacion_actual is 270)[
    (set: _respuesta_correcta to "arriba")
]

(if: $eleccion_usuario is _respuesta_correcta)[
    (set: $aciertos_snellen to it + 1)
    (set: $robot_estado to "feliz")
](else:)[
    (set: $errores_snellen to it + 1)
    (set: $robot_estado to "triste")
]

(set: $ronda_e to it + 1)

(set: _tamanos to (a: 30, 24, 18, 14, 10, 7, 5, 3.5, 2.5, 1.5))

(if: $ronda_e <= 10)[
    (set: $tamano_actual to _tamanos's ($ronda_e))
]

(set: $rotacion_actual to (either: 0, 90, 180, 270))

(if: $ronda_e > 10)[
    (go-to: "ResultadosNivelDos")
](else:)[
    (go-to: "JuegoNivelDos")
]
}



:: ResultadosNivelDos
{
(set: _mensaje_diagnostico to "")
(set: _color_diag to "#000")

(if: $aciertos_snellen >= 9)[
    (set: _mensaje_diagnostico to "DIAGNÓSTICO PRELIMINAR: Agudeza visual óptima. Tienes una vista excelente; no se detectan problemas para enfocar a la distancia.")
    (set: _color_diag to "#004085")
](elseif: $aciertos_snellen >= 6)[
    (set: _mensaje_diagnostico to "DIAGNÓSTICO PRELIMINAR: Agudeza visual aceptable, pero presentas dificultad con los tamaños más pequeños. Podría ser un indicio de fatiga visual o miopía leve.")
    (set: _color_diag to "#e65100")
](else:)[
    (set: _mensaje_diagnostico to "DIAGNÓSTICO PRELIMINAR: Dificultad severa para enfocar. Es altamente recomendable que visites a un especialista para una evaluación visual completa.")
    (set: _color_diag to "#b71c1c")
]
}

