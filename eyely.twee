<div class="config-card">
    <h2 class="config-titulo">CALIBRACIÓN VISUAL</h2>
    <p class="config-texto">Para un diagnóstico preciso, ajusta los controles hasta que el símbolo dentro de la caja oscura sea <b>apenas visible</b>.</p>

    <div class="calibracion-wrapper">
        <img src="imagenes/robot/configuracion/robotapuntando.gif" class="robot-pizarra" alt="Rob profesor">

        <div class="calibracion-caja">
            <img src="imagenes/ojo.png" class="calibracion-simbolo" alt="Símbolo de prueba">
        </div>

        <div class="controles-caja">
            <label>Brillo</label>
            <input type="range" id="barraBrillo" class="slider-estilo" min="0.5" max="1.5" step="0.05" value="1">
            
            <label>Contraste</label>
            <input type="range" id="barraContraste" class="slider-estilo" min="0.5" max="1.5" step="0.05" value="1">
        </div>
    </div>

    <div class="config-footer">
        [[GUARDAR Y VOLVER AL MENÚ->INICIO]]
    </div>
</div>



<script>
setTimeout(function() {
    const sBrillo = document.getElementById('barraBrillo');
    const sContraste = document.getElementById('barraContraste');

    if(window.nivelBrillo) sBrillo.value = window.nivelBrillo;
    if(window.nivelContraste) sContraste.value = window.nivelContraste;

    function aplicarFiltros() {
        window.nivelBrillo = sBrillo.value;
        window.nivelContraste = sContraste.value;
        document.body.style.filter = `brightness(${sBrillo.value}) contrast(${sContraste.value})`;
    }

    sBrillo.addEventListener('input', aplicarFiltros);
    sContraste.addEventListener('input', aplicarFiltros);
}, 100); 
</script>
:: StoryScript [script]



// --- GESTOR DE AUDIO GLOBAL ---
(function() {
    // 1. Cargamos tu canción en la memoria (asegúrate de que la ruta sea correcta)
    window.musicaMenu = new Audio("sonido/fondo.mp3"); 
    window.musicaMenu.loop = false;

    // 2. Le decimos al navegador: "En cuanto el usuario haga su PRIMER CLIC en la pantalla, enciende el audio"
    // Este clic será cuando presionen "INICIAR SISTEMA" en la Pantalla Cero.
    document.body.addEventListener('click', function() {
        window.musicaMenu.play().catch(function(e) {
            console.log("Audio esperando interacción...");
        });
    }, { once: true }); // El "once: true" hace que este evento solo funcione una vez

    // 3. Creamos un interruptor para apagarla cuando entremos al juego
    window.detenerMusica = function() {
        if (window.musicaMenu) {
            window.musicaMenu.pause();
            window.musicaMenu.currentTime = 0; // Regresa la canción al principio
        }
    };
})();


// --- MOTOR DE PARTÍCULAS DINÁMICAS ---
(function() {
    // 1. Aquí pones las rutas EXACTAS de tus 5 imágenes preparadas
    const imagenesParticulas = [
        "imagenes/cruz.png",
        "imagenes/control.png",
        "imagenes/ojo.png",
        "imagenes/ojo2.png",
        "imagenes/lentes.png",
        "imagenes/robot.png" 
    ];

    function crearContenedor() {
        if (!document.getElementById('particle-container')) {
            const container = document.createElement('div');
            container.id = 'particle-container';
            // Lo anclamos al fondo de toda la página para que no se borre al cambiar de menú
            document.body.appendChild(container); 
        }
    }

    function spawnParticula() {
        const container = document.getElementById('particle-container');
        if (!container) return;

        const img = document.createElement('img');
        
        // Elige una de tus 5 imágenes al azar
        img.src = imagenesParticulas[Math.floor(Math.random() * imagenesParticulas.length)];
        img.className = 'particula-flotante';

        // Tamaño aleatorio (entre 30px y 70px)
        const size = Math.random() * 40 + 30; 
        img.style.width = size + 'px';
        
        // Rotación aleatoria para que giren mientras suben
        const rotacionInicial = Math.random() * 360;
        const rotacionFinal = rotacionInicial + (Math.random() * 360 - 180); 

        // Puntos de inicio y fin (Salen de abajo y suben a lo alto de la pantalla)
        const startX = Math.random() * window.innerWidth; // Posición horizontal aleatoria
        const startY = window.innerHeight + 100; // Empiezan escondidas abajo
        
        const endX = startX + (Math.random() * 300 - 150); // Se desvían un poco a la izq o der
        const endY = -150; // Terminan escondidas arriba

        // Velocidad de la animación (entre 10 y 20 segundos para que sea súper relajante)
        const duration = Math.random() * 10000 + 10000; 

        // Posición inicial
        img.style.left = startX + 'px';
        img.style.top = startY + 'px';
        img.style.transform = `rotate(${rotacionInicial}deg)`;
        img.style.transition = `top ${duration}ms linear, left ${duration}ms linear, transform ${duration}ms linear`;

        container.appendChild(img);

        // Forzamos al navegador a leer la posición inicial antes de moverlas
        void img.offsetWidth;

        // Arrancamos el movimiento hacia arriba
        img.style.top = endY + 'px';
        img.style.left = endX + 'px';
        img.style.transform = `rotate(${rotacionFinal}deg)`;

        // Autodestrucción de la imagen cuando sale de la pantalla (evita que tu laptop se trabe)
        setTimeout(function() {
            if (img.parentNode) {
                img.parentNode.removeChild(img);
            }
        }, duration);
    }

    // Inicializamos el sistema
    if (document.readyState === 'complete') {
        crearContenedor();
        setInterval(spawnParticula, 2500); // Crea una nueva partícula cada 2.5 segundos
    } else {
        window.addEventListener('load', function() {
            crearContenedor();
            setInterval(spawnParticula, 2500);
        });
    }
})();

:: StoryStylesheet [stylesheet]


/*******************************************************
   SISTEMA DE PARTÍCULAS (Fondo Dinámico)
********************************************************/
#particle-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1; /* Esto lo pone POR ENCIMA de tu fondo 1.png... */
    pointer-events: none; /* Evita que las imágenes bloqueen tus clics */
    overflow: hidden; 
}

.main-menu-card, .pantalla-cero {
    position: relative;
    z-index: 10; /* ...y esto asegura que tu tarjeta esté POR ENCIMA de las partículas */
}

.particula-flotante {
    position: absolute;
    opacity: 0.3; /* Semitransparentes para que no distraigan. Puedes subirlo a 0.5 si quieres */
    filter: drop-shadow(0px 0px 5px rgba(0, 188, 212, 0.3)); /* Un brillo sutil turquesa */
}




/*******************************************************
   ESTILOS GENERALES Y FONDO
********************************************************/
tw-story {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-image: url("imagenes/1.png"); 
    background-size: cover;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #f0f4f8; 
    color: #333333;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center; 
}

tw-sidebar { display: none; }
tw-link { color: inherit; text-decoration: none; }

/*******************************************************
   LA TARJETA (Ahora aún más transparente)
********************************************************/
.main-menu-card {
    background-color: rgba(255, 255, 255, 0.20); /* <-- Súper transparente al 0.20 */
    backdrop-filter: blur(12px); 
    -webkit-backdrop-filter: blur(12px); 
    border-radius: 30px; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.1); 
    
    width: 85vw; 
    max-width: 1100px; 
    height: 85vh; 
    
    padding: 30px 40px; 
    display: flex;
    flex-direction: column;
    justify-content: space-between; 
    align-items: center; 
    box-sizing: border-box;
}

/*******************************************************
   ZONA SUPERIOR: LOGO
********************************************************/
.menu-header {
    display: flex;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 80px; /* <-- Esto empuja el botón JUGAR hacia abajo, separándolo del logo */
}

/*******************************************************
   ESTILOS DEL LOGO (Más grande)
********************************************************/
.main-logo {
    max-width: 500px; 
    height: auto;
    filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.1));
    
    /* Le decimos que use la animación "respirar", que dure 4 segundos, 
       que sea suave (ease-in-out) y que se repita al infinito */
    animation: respirar 4s ease-in-out infinite;
}

/* Aquí creamos los "fotogramas" de la animación */
@keyframes respirar {
    0% { transform: scale(1); }       /* Tamaño normal al inicio */
    50% { transform: scale(0.96); }   /* Se encoge un 4% a la mitad del tiempo */
    100% { transform: scale(1); }     /* Vuelve a la normalidad al final */
}

/*******************************************************
   ZONA CENTRAL: JUGAR PERFECTAMENTE CENTRADO
********************************************************/
.menu-middle {
    position: relative; /* Clave para aislar al robot */
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    flex-grow: 1; /* Esto hace que ocupe todo el espacio central libre */
}

/*******************************************************
   ROBOT ANIMADO
********************************************************/
.robot-section {
    position: absolute;
    left: -20px; /* <--- Ajusta este número para moverlo a la izquierda/derecha */
    top: 50%; 
    transform: translateY(-50%); 
    z-index: 3; 
    pointer-events: none; 
}

.robot-animado {
    width: 220px; /* <--- Ajusta qué tan grande quieres tu GIF aquí */
    height: auto;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.2)); 
}

/* Un pequeño efecto opcional: si pasas el mouse sobre él, reacciona flotando un poquito */
.robot-animado:hover {
    transform: translateY(-10px);
}

/* El botón ahora domina el centro */
.jugar-section {
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 2;
}

/* El botón domina el centro y se alinea con los iconos */
.jugar-section {
    width: 85%; /* Mismo ancho que tienen los iconos de abajo */
    max-width: 750px;
    display: flex;
    justify-content: center;
    z-index: 2;
}

/* Forzamos a Twine a respetar el tamaño */
.jugar-section tw-expression, 
.jugar-section tw-hook {
    width: 100%;
}

/*******************************************************
   ESTILOS DEL BOTÓN JUGAR (Alto y rectangular)
********************************************************/
.jugar-section tw-link {
    background-color: #33abac; 
    color: #ffffff;
    font-size: 80px; 
    font-weight: bold;
    text-transform: uppercase;
    width: 100%; 
    text-align: center;
    padding: 40px 0; /* <-- Mucho más alto verticalmente */
    border-radius: 20px; /* <-- Bordes suavizados (menos redondeado, forma rectangular) */
    
    

    box-shadow: 0 0 30px rgba(0, 188, 212, 0.8), 0 6px 12px rgba(0,0,0,0.2);
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    display: block !important; 
    box-sizing: border-box;
}

/* Opcional: Hacemos que el brillo sea más intenso al pasar el mouse */
.jugar-section tw-link:hover {
    background-color: #00acc1; 
    box-shadow: 0 0 45px rgba(0, 188, 212, 1), 0 6px 12px rgba(0,0,0,0.3);
}
.jugar-section tw-link:active {
    transform: scale(0.98); 
}

/*******************************************************
   ZONA INFERIOR: ICONOS GIGANTES
********************************************************/
.menu-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    padding-bottom: 20px;
}

.footer-icons-wrapper {
    display: flex;
    justify-content: space-between; /* Distribuye el espacio entre los 3 íconos */
    width: 85%; /* Mismo ancho idéntico que el botón JUGAR */
    max-width: 750px;
}

.footer-icon-item tw-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #004085;
    font-size: 24px; /* <--- Texto mucho más grande (antes era 16px) */
    font-weight: bold;
}

.menu-icon {
    width: 190px; /* Tamaño gigantesco como pediste (casi 200px) */
    height: auto;
    max-height: 190px;
    object-fit: contain;
    margin-bottom: -10px;
    transition: transform 0.2s;
}

.menu-icon:hover {
    transform: scale(1.05);
}

.footer-icon-item img {
    border: none;
}

/*******************************************************
   PANTALLA CERO (Botón inicial)
********************************************************/
.pantalla-cero tw-link {
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 20px 50px;
    border-radius: 15px;
    color: #004085;
    font-size: 28px;
    font-weight: bold;
    text-transform: uppercase;
    border: 2px solid #00bcd4;
    box-shadow: 0 0 20px rgba(0, 188, 212, 0.4);
    transition: all 0.3s ease;
    display: inline-block;
    
    /* ¡Aprovechamos la misma animación de respiración que le dimos al logo! */
    animation: respirar 3s ease-in-out infinite; 
}

.pantalla-cero tw-link:hover {
    background-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
    box-shadow: 0 0 30px rgba(0, 188, 212, 0.8);
}


/*******************************************************
   VENTANA DE CONFIGURACIÓN Y CALIBRACIÓN
********************************************************/
.config-card {
    background-color: rgba(255, 255, 255, 0.20); 
    backdrop-filter: blur(15px); 
    -webkit-backdrop-filter: blur(15px); 
    border-radius: 20px; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.2); 
    width: 70vw; 
    max-width: 800px; 
    padding: 40px; 
    display: flex;
    flex-direction: column;
    align-items: center; 
}

.config-titulo {
    color: #004085;
    font-size: 36px;
    margin-top: 0;
    margin-bottom: 10px;
    letter-spacing: 2px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.config-texto {
    color: #004085;
    font-size: 18px;
    text-align: center;
    margin-bottom: 30px;
}

.calibracion-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    width: 100%;
    margin-bottom: 40px;
}

/* La magia de la caja oscura */
.calibracion-caja {
    width: 180px;
    height: 180px;
    background-color: #050505; /* Fondo casi negro */
    border: 2px solid #333;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: inset 0 0 20px rgba(0,0,0,1);
}

.calibracion-simbolo {
    width: 80px;
    height: auto;
    /* Oscurecemos totalmente la imagen original y la dejamos gris muy oscuro */
    filter: brightness(0) invert(0.15); 
}

.controles-caja {
    display: flex;
    flex-direction: column;
    width: 300px;
    gap: 15px;
}

.controles-caja label {
    color: #004085;
    font-weight: bold;
    font-size: 18px;
    margin-bottom: -5px;
}

/* Estilo para las barras deslizables */
.slider-estilo {
    -webkit-appearance: none;
    width: 100%;
    height: 8px;
    background: rgba(0, 64, 133, 0.3);
    border-radius: 5px;
    outline: none;
}

.slider-estilo::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: #00bcd4;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(0, 188, 212, 0.8);
}

.config-footer tw-link {
    background-color: #004085;
    color: white;
    padding: 15px 40px;
    border-radius: 10px;
    font-size: 20px;
    font-weight: bold;
    transition: all 0.2s;
}

.config-footer tw-link:hover {
    background-color: #00bcd4;
    transform: scale(1.05);
}

.robot-pizarra {
    width: 160px; /* Ajusta este valor si sientes que tu robot quedó muy chico o muy grande */
    height: auto;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.2)); /* Le da sombra para integrarlo al cristal */
    transform: translateY(10px); /* Esto lo baja un poquito por si no queda alineado con la caja negra, ajústalo a tu gusto */
}





/*******************************************************
   VENTANA DE INFORMACIÓN (Estilo RPG)
********************************************************/
/* Tarjeta de información: Ahora es un rectángulo ancho */
.info-card {
    background-color: rgba(255, 255, 255, 0.20); 
    backdrop-filter: blur(15px); 
    -webkit-backdrop-filter: blur(15px); 
    border-radius: 30px; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.2); 
    width: 85vw; 
    max-width: 1100px; 
    min-height: 70vh; 
    padding: 40px; 
    display: flex;
    flex-direction: column;
    align-items: center; 
    justify-content: space-between; 
    box-sizing: border-box;
}

/* Contenedor: Alineado a la izquierda para acercar al robot */
.info-layout {
    display: flex;
    align-items: center;
    justify-content: flex-start; /* Empujamos todo a la izquierda */
    width: 100%;
    flex-grow: 1;
    padding: 0 40px; /* Margen para que el robot no toque el borde */
    box-sizing: border-box;
    position: relative; /* Clave para la superposición */
}

/* Tu Robot PNG (estático) */
.robot-info-image {
    width: 500px; 
    height: auto;
    flex-shrink: 0; 
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.2)); 
    
    /* Superposición: Posición relativa para usar z-index */
    position: relative;
    z-index: 1; /* Abajo del sándwich */
    
    /* Alineación vertical (ajusta si el piquito no da en la boca) */
    transform: translateY(15px); 
}


/* El globo de diálogo (Flotante y superpuesto) */
.speech-bubble {
    position: relative;
    background: rgba(255, 255, 255, 0.9); /* Un poco más opaco para leer mejor sobre el robot */
    border: 3px solid #00bcd4;
    border-radius: 15px;
    padding: 30px; 
    
    flex-grow: 1; 
    width: 100%; 
    max-width: 700px; /* Reducimos el max-width para que no se vea tan largo horizontalmente */
    min-height: 150px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);

    /* Superposición: z-index superior */
    z-index: 2; /* Arriba del robot */
    
    /* EL TRUCO: Margen izquierdo negativo para encimarlo sobre el robot */
    margin-left: -70px; /* <--- Ajusta este número para acercarlo/alejarlo del robot */

    /* Animación de flotado (la creamos abajo) */
    animation: flotarBubble 4s ease-in-out infinite; 
}

/* --- Ajuste fino de los "piquitos" para que nazcan de la boca --- */
/* El piquito del globo (borde) */
.speech-bubble::before {
    content: '';
    position: absolute;
    left: -20px; /* Ajustamos para que nazca *detrás* del borde */
    
    /* ALINEACIÓN CON LA BOCA: Ajusta este % (entre 30% y 50%) según tu robot */
    top: 35%; /* Subimos el piquito para que coincida con la boca de la imagen */
    
    transform: translateY(-50%);
    border-width: 10px 20px 10px 0; /* Piquito un poco más largo horizontalmente */
    border-style: solid;
    border-color: transparent #00bcd4 transparent transparent;
}

/* El piquito del globo (relleno blanco) */
.speech-bubble::after {
    content: '';
    position: absolute;
    left: -15px; /* Ajuste preciso */
    
    /* ALINEACIÓN CON LA BOCA: Debe ser el mismo % que el ::before */
    top: 35%; 
    
    transform: translateY(-50%);
    border-width: 8px 16px 8px 0;
    border-style: solid;
    border-color: transparent white transparent transparent;
}

/* Definición de la animación de flotado */
@keyframes flotarBubble {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); } /* Sube 10px a la mitad del ciclo */
    100% { transform: translateY(0px); }
}

/* El estilo de la letra retro (mantener igual) */
.speech-text {
    font-family: 'Courier New', Courier, monospace; 
    font-size: 20px;
    color: #004085;
    font-weight: bold;
    line-height: 1.5;
}





/*******************************************************
   NIVEL 1: TEST DE ISHIHARA (Panel Retro)
********************************************************/
/* Contenedor principal para centrar la máquina */
.game-level-card {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100vw;
    height: 100vh;
}

/* LA MÁQUINA (Tu imagen de fondo) */
/* === Definición de la animación de alerta (Pulsación Roja) === */
@keyframes alertaBloqueo {
    /* Estado inicial: Sombra oscura base original */
    0% {
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
    }
    /* A la mitad del ciclo: Resplandor rojo intenso y suave */
    50% {
        box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 50px rgba(255, 0, 0, 0.9);
    }
    /* Regresamos al estado inicial */
    100% {
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
    }
}

/* === Tu bloque de panel actualizado === */
.game-control-panel {
    position: relative;
    
    /* ¡Asegúrate que esta ruta a tu imagen sea correcta! */
    background-image: url("imagenes/fondos/3.png"); 
    background-size: cover;
    background-position: center;
    border-radius: 30px;
    
    /* Quitamos el box-shadow fijo y aplicamos la animación */
    /* Usamos: alertaBloqueo (nombre), 4s (duración lenta), ease-in-out (suave), infinite (bucle) */
    animation: alertaBloqueo 4s ease-in-out infinite;

    /* --- LÓGICA DE ADAPTABILIDAD PROPORCIONAL (Se mantiene) --- */
    height: 85vh; /* Ajuste para dar aire con el robot */
    aspect-ratio: 1 / 1.05; 
    max-width: 70vw; /* Ajuste para el robot */
}



/* =======================================================
   ELEMENTOS INTERNOS ADAPTABLES (Escalan con la máquina)
======================================================== */

/* MARCADORES (Arriba) */
.panel-header {
    position: absolute;
    top: 0%; /* Lo bajamos un poquito para que no toque el borde */
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.panel-title {
    color: #f8f8f8;
    font-size: 2.2vh; /* Se adapta a la altura de la pantalla */
    margin: 0 1 0.8vh 0;
    font-weight: bold;
    text-transform: uppercase;
}

/* === REEMPLAZA ESTE BLOQUE (EL CONTENEDOR NEGRO) === */
.panel-counters {
    background-color: #050505;
    border: 2px solid #00bcd4;
    border-radius: 5px;
    
    /* Ajustamos el espacio interno (Padding) */
    /* El primer número es arriba/abajo, el segundo es izquierda/derecha */
    padding: 0.0vh 0.8vh; 
    
    /* Quitamos cualquier ancho fijo que pudiera tener */
    width: auto; 
    display: inline-block; /* Esto hace que la caja solo crezca lo necesario para envolver al texto */
    
    /* Sombra interna para el efecto digital */
    box-shadow: inset 0 0 8px rgba(0, 188, 212, 0.3);
    
    /* Alineación */
    margin-top: 0.5vh;
}

.counter-text {
    font-family: 'Courier New', Courier, monospace;
    color: #00bcd4;
    font-weight: bold;
    
    /* --- EL CAMBIO CLAVE --- */
    font-size: 1.8vh; /* Hacemos la letra del contador más pequeña y sutil */
    
    margin: 0 0.8vh;
}

/* LA PANTALLA BLANCA (Donde salen las láminas) */
.panel-screen {
    position: absolute;
    top: 25%; /* Ajustado para centrar mejor verticalmente */
    left: 14%;
    width: 72%;
    height: 44%; /* Un poco más bajito para dar aire */
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: transparent; 
}

.ishihara-plate {
    /* --- EL CAMBIO CLAVE --- */
    max-width: 70%; /* Reducimos la lámina al 80% del espacio para que respire */
    max-height: 70%;
    margin-left: 18%;
    
    object-fit: contain;
    filter: drop-shadow(0px 5px 10px rgba(0,0,0,0.2));
}


/* LA CONSOLA DE BOTONES (Abajo) */
.panel-console {
    position: absolute;
    bottom: 6%; /* Subimos un poco para cuadrar con los dibujos de tu panel */
    width: 100%;
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    padding: 0 10%;
    box-sizing: border-box;
}

.console-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Ocultamos esta etiqueta porque tu imagen ya trae el texto dibujado */
.input-label {
    display: none; 
}

/* CAJA DE TEXTO DONDE ESCRIBE EL USUARIO */
.console-item input[type="text"] {
    background-color: #111;
    color: #00bcd4;
    border: 3px solid #00bcd4;
    border-radius: 8px;
    padding: 0.8vh;
    font-family: 'Courier New', Courier, monospace;
    font-size: 2.2vh;
    font-weight: bold;
    text-align: center;
    width: 12vh; /* Ancho dinámico */
    box-shadow: inset 0 0 10px rgba(0, 188, 212, 0.5);
    outline: none;
    margin-bottom: 0.5vh;
}

/* EL BOTÓN DE ENVIAR (SUBMIT) */
.submit-button-section tw-link {
    background-color: #39c0bb;
    color: white;
    font-size: 2vh;
    font-weight: bold;
    padding: 1.2vh 3vh;
    border-radius: 10px;
    border: 2px solid #3698a4;
    box-shadow: 0 0.4vh 0 #3698a4, 0 0.8vh 1.5vh rgba(0,0,0,0.3);
    text-transform: uppercase;
    transition: all 0.1s;
    display: inline-block;
}

.submit-button-section tw-link:active {
    transform: translateY(0.4vh);
    box-shadow: 0 0 0 #00838f, 0 0.2vh 0.5vh rgba(0,0,0,0.3); 
}

/* EL BOTÓN DE SALIR (EXIT) */
.exit-button-section tw-link {
    background-color: #efa045;
    color: white;
    font-size: 1.5vh;
    font-weight: bold;
    padding: 1vh 2vh;
    border-radius: 8px;
    border: 2px solid #6c5442;
    box-shadow: 0 0.4vh 0 #c87840;
    text-transform: uppercase;
}

.exit-button-section tw-link:active {
    transform: translateY(0.4vh);
    box-shadow: 0 0 0 #b71c1c;
}

/*******************************************************
   ROBOT ACOMPAÑANTE (En el Nivel 1)
********************************************************/
/* Contenedor principal que envuelve a la máquina y al robot */
.game-layout-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px; /* Espacio entre la máquina y el robot */
    width: 100vw;
    height: 100vh;
    padding: 20px;
    box-sizing: border-box;
}

/* Reducimos ligeramente la máquina para que quepa el robot a un lado */
.game-control-panel {
    /* Mantenemos lo anterior, solo ajustamos max-width */
    position: relative;
    height: 85vh; /* Un poco más bajito */
    aspect-ratio: 1 / 1.05; 
    max-width: 70vw; /* Dejamos 30vw para el robot */
    margin: 0; /* Quitamos margin auto */
}

/* El contenedor del Robot y su diálogo */
.robot-companion-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 25vw;
    max-width: 300px;
    position: relative; 
    margin-top: -1vh; /* Subimos un poco para alinear con la pantalla */
}

/* La Imagen del Robot */
/* === Definición de la animación de respiración === */
@keyframes respirarRobot {
    /* Estado inicial y final: tamaño normal y posicionado */
    0%, 100% {
        transform: scale(1) translateY(0px);
    }
    /* A la mitad del ciclo: se encoge un 3% y baja 3px (settling breath) */
    50% {
        transform: scale(0.97) translateY(3px); 
    }
}

/* === La clase de tu robot (Actualizada con animación) === */
.robot-state-image {
    width: 100%;
    height: auto;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.3));
    
    /* Esta transición se queda, es para los cambios de estado (feliz/triste) */
    transition: all 0.3s ease; 
    
    z-index: 1;

    /* --- EL CAMBIO CLAVE: APLICAR LA ANIMACIÓN --- */
    /* Usamos: respirarRobot (nombre), 5s (lento), ease-in-out (suave), infinite (bucle) */
    animation: respirarRobot 5s ease-in-out infinite;
    
    /* Le decimos que la animación ocurra desde su base (pies) para que no flote */
    transform-origin: bottom center;
}


/* El Globo de Texto (Reusando estilo RPG pero adaptado) */
.robot-speech-bubble {
    position: absolute;
    bottom: 100%; /* Flota por encima del robot */
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.95);
    border: 3px solid #00bcd4;
    border-radius: 15px;
    padding: 15px;
    width: 250px;
    min-height: 80px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
    z-index: 2;
    margin-bottom: 20px;
    
    /* Efecto de desvanecimiento para cuando desaparezca */
    transition: opacity 0.5s ease, visibility 0.5s ease;
    opacity: 1;
    visibility: visible;
}

/* Ocultar el globo */
.robot-speech-bubble.hidden {
    opacity: 0;
    visibility: hidden;
}

/* El piquito del globo (apuntando hacia abajo) */
.robot-speech-bubble::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    border-width: 15px 10px 0 10px;
    border-style: solid;
    border-color: #00bcd4 transparent transparent transparent;
}
.robot-speech-bubble::before {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    border-width: 12px 8px 0 8px;
    border-style: solid;
    border-color: white transparent transparent transparent;
    z-index: 1;
}

/* El texto retro */
.robot-speech-text {
    font-family: 'Courier New', Courier, monospace;
    font-size: 14px;
    color: #004085;
    font-weight: bold;
    line-height: 1.4;
    text-align: center;
}

/* =======================================================
   TRANSICIÓN CLÁSICA 8-BITS (Desvanecimiento desde negro)
======================================================== */
.fade-in-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #000000; /* Negro puro total */
    z-index: 9999; /* Asegura que esté por encima de TODO (robot, máquina, etc) */
    pointer-events: none; /* Evita que la capa invisible bloquee tus clics después */
    
    /* Animación: dura 1.5 segundos, suave, y se queda en el estado final (forwards) */
    animation: desvanecerCapaNegra 1.5s ease-out forwards;
}

@keyframes desvanecerCapaNegra {
    0% {
        opacity: 1;
    }
    100% {
        opacity: 0;
        visibility: hidden; /* Se apaga por completo para no estorbar */
    }
}



















/* =======================================================
   BOTÓN ARCADE (Para avanzar de nivel)
======================================================== */
.boton-arcade tw-link {
    display: inline-block;
    background-color: #004085; /* Azul institucional */
    color: #ffffff !important;
    padding: 1.5vh 3vw;
    border-radius: 30px;
    font-weight: bold;
    font-size: 2.2vh;
    text-decoration: none;
    border: 2px solid #00bcd4; /* Borde neón */
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    transition: all 0.2s ease;
}

.boton-arcade tw-link:hover {
    background-color: #00bcd4;
    color: #004085 !important;
    transform: scale(1.05); /* Efecto de crecimiento al apuntar */
}






/* =======================================================
   NIVEL 2: D-PAD (Cruceta Direccional Arcade)
======================================================== */
.dpad-container {
    display: grid;
    grid-template-columns: 4.5vh 4.5vh 4.5vh;
    grid-template-rows: 4.5vh 4.5vh 4.5vh;
    gap: 0.1vh; 
    justify-content: center;
    margin-top: 2vh; 
}

/* Posiciones exactas en la cuadrícula de 3x3 */
.btn-up    { grid-column: 2; grid-row: 1; }
.btn-left  { grid-column: 1; grid-row: 2; }
.btn-right { grid-column: 3; grid-row: 2; }
.btn-down  { grid-column: 2; grid-row: 3; }

/* Estilo de los botones direccionales */
.dpad-btn tw-link {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    background-color: #2c3e50;
    color: #00bcd4 !important;
    font-size: 4vh; /* Tamaño de las flechas */
    font-weight: bold;
    border-radius: 15px;
    border: 3px solid #1a252f;
    box-shadow: 0 6px 0 #11181f, 0 10px 15px rgba(0,0,0,0.5); /* Efecto 3D de botón físico */
    text-decoration: none;
    transition: all 0.1s ease;
}

/* Efecto al presionar el botón (se hunde) */
.dpad-btn tw-link:active {
    transform: translateY(6px);
    box-shadow: 0 0px 0 #11181f, 0 2px 5px rgba(0,0,0,0.5);
}

/* =======================================================
   NIVEL 2: LETRA "E" DINÁMICA
======================================================== */
.letra-snellen {
    transition: all 0.5s ease-in-out; /* Animación suave al girar o encogerse */
    filter: drop-shadow(0px 5px 10px rgba(0,0,0,0.2));
}







