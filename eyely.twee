:: StoryTitle
Diagnóstico Visual - OftalmoBot

:: StoryData
{
  "ifid": "82C644F5-04D6-4AE9-9291-75810C5AD29E",
  "format": "Harlowe",
  "format-version": "3.3.9",
  "start": "PantallaCero",
  "zoom": 1
}

:: PantallaCero {"position":"300,100","size":"100,100"}
<audio id="musicaMenu" src="sonido/fondo.mp3" autoplay loop></audio>
(set: $juego_iniciado to false)


<script>
    // Guardamos la música del menú en la memoria global de la ventana
    window.musicaMenu = document.getElementById('musicaMenu');
    // Le bajamos un poquito el volumen para que no sature
    if(window.musicaMenu) window.musicaMenu.volume = 0.5;
</script>


<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #111; z-index: 9999; display: flex; justify-content: center; align-items: center; flex-direction: column;">
    <h1 style="color: #00bcd4; font-family: 'Segoe UI', sans-serif; letter-spacing: 5px; margin-bottom: 40px;">SISTEMA EYELY OS</h1>
    <div class="pantalla-cero">
        [[ INICIAR SISTEMA ->INICIO]]
    </div>
</div>

:: INICIO {"position":"500,100","size":"100,100"}
<div class="main-menu-card">

  <div class="menu-header">
    <img src="imagenes/logo.png" class="main-logo" alt="Logo Eyely">
  </div>

  <div class="menu-middle">
    
    <div class="robot-section">
      <img src="imagenes/robot/menu/eyelyidlegif.gif" class="robot-animado" alt="Oftalmo-Bot">
    </div>
    
    <div class="jugar-section">
      [[JUGAR->JuegoMain]]
    </div>

  </div>

  <div class="menu-footer">
    <div class="footer-icons-wrapper">
      
      <div class="footer-icon-item">
