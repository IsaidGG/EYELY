<audio id="sonidoBlip" src="sonido/1bit.mp3"></audio>

<div class="info-card">
    <h2 class="config-titulo">ACERCA DE EYELY</h2>

    <div class="info-layout">
        <img src="imagenes/robot/informacion/informacion.gif" class="robot-info-image" alt="Oftalmo-Bot Presentando">

        <div class="speech-bubble">
            <div id="texto-maquina" class="speech-text"></div>
        </div>
    </div>

    <div class="config-footer">
        [[VOLVER AL MENÚ->INICIO]]
    </div>
</div>

<script>
// Motor de máquina de escribir
setTimeout(function() {
    const textoAImprimir = "¡Hola! Bienvenido a Eyely. Este sistema interactivo está diseñado como una herramienta para realizar pruebas rápidas y ayudarte a diagnosticar posibles problemas visuales. ¡Recuerda que la salud de tus ojos es muy importante!";
    
    const contenedorTexto = document.getElementById('texto-maquina');
    const sonidoBlip = document.getElementById('sonidoBlip');
    let indice = 0;

    // Bajamos un poco el volumen del blip para que no lastime los oídos
    if(sonidoBlip) sonidoBlip.volume = 0.9; 

    function escribirLetra() {
        if (indice < textoAImprimir.length) {
            // Agregamos la letra actual
            contenedorTexto.innerHTML += textoAImprimir.charAt(indice);
            
            // Reproducimos el sonido SOLO si no es un espacio en blanco
            if (textoAImprimir.charAt(indice) !== ' ' && sonidoBlip) {
                sonidoBlip.currentTime = 0; // Regresa el audio al inicio al instante
                sonidoBlip.play().catch(function(e){}); // Dispara el sonido
            }
            
            indice++;
            // Velocidad de escritura: 40 milisegundos entre cada letra
            setTimeout(escribirLetra, 40); 
        }
    }

    // Iniciamos la animación
    escribirLetra();
}, 100); // Pequeño retraso para que cargue la pantalla primero
</script>



