      </div>
      
      <div class="footer-icon-item">
        [[<img src="imagenes/informacion.png" class="menu-icon">Información->InformacionGral]]
      </div>
      
      <div class="footer-icon-item">
        [[<img src="imagenes/configuracion.png" class="menu-icon">Configuración->ConfiguracionAjustes]]
      </div>

