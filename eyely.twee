<audio id="sonidoBlipResN2" src="sonido/1bit.mp3"></audio>

<script>
    // Motor de escritura con el blip
    setTimeout(function() {
        const contenedorVisible = document.getElementById('texto-diagnostico-n2');
        const contenedorOculto = document.getElementById('hidden-diag-n2');
        const sonidoBlip = document.getElementById('sonidoBlipResN2');
        
        if (!contenedorVisible || !contenedorOculto) return;
        if(sonidoBlip) sonidoBlip.volume = 0.3;

        const mensaje = contenedorOculto.innerText.trim();
        let indiceLetra = 0;

        function escribirLetra() {
            if(!document.getElementById('texto-diagnostico-n2')) return; 

            if (indiceLetra < mensaje.length) {
                contenedorVisible.innerHTML += mensaje.charAt(indiceLetra);
                
                if (mensaje.charAt(indiceLetra) !== ' ' && sonidoBlip) {
                    sonidoBlip.currentTime = 0; 
                    sonidoBlip.play().catch(function(e){}); 
                }
                
                indiceLetra++;
                setTimeout(escribirLetra, 40); 
            }
        }
        
        escribirLetra();
    }, 200);
</script>

























